# Modelo do .env de PRODUÇÃO. No servidor: cp .env.production.example .env
# e preencha tudo que está marcado com TROCAR. Nunca faça commit do .env real.
# Passo a passo completo: docs/deploy.md

APP_NAME=Wishlisti
APP_ENV=production
# Gere com: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Domínio do site, sem https:// (o Caddy emite o certificado para ele)
APP_DOMAIN=TROCAR.com.br
APP_URL=https://${APP_DOMAIN}

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily: arquivos diários em storage/logs (volume storage_logs), lidos no
#   painel em /admin/logs e apagados depois de LOG_DAILY_DAYS dias
# stderr: também em "docker compose -f docker-compose.prod.yml logs"
# telegram: erros mandados na hora para o Telegram (ver docs/deploy.md)
LOG_CHANNEL=stack
LOG_STACK=daily,stderr,telegram
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_TELEGRAM_BOT_TOKEN=
LOG_TELEGRAM_CHAT_ID=
# Só erros (error) por padrão; a mesma mensagem é mandada no máximo uma vez
# a cada LOG_TELEGRAM_QUIET_MINUTES minutos
LOG_TELEGRAM_LEVEL=error
LOG_TELEGRAM_QUIET_MINUTES=10

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wishlisti
DB_USERNAME=wishlisti
# Senhas longas e diferentes entre si (ex.: openssl rand -base64 24)
DB_PASSWORD=TROCAR
DB_ROOT_PASSWORD=TROCAR

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail de verdade (convites, redefinição de senha). Exemplo com o Email
# Delivery da Oracle (região São Paulo); usuário e senha SMTP são gerados no
# console da Oracle, em "Email Delivery". Qualquer outro SMTP também serve.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
MAIL_PORT=587
MAIL_USERNAME=TROCAR
MAIL_PASSWORD=TROCAR
MAIL_FROM_ADDRESS="nao-responda@${APP_DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"

# Conta Mercado Pago da plataforma (recebe o pagamento do plano premium).
# Use as credenciais de PRODUÇÃO, não as de teste.
MERCADOPAGO_ACCESS_TOKEN=TROCAR
MERCADOPAGO_PUBLIC_KEY=TROCAR
PREMIUM_PRICE=39.90
FREE_GIFT_LIMIT=15

# Backup diário (docker/backup.sh): bucket que recebe as cópias. Exemplo com o
# Object Storage da Oracle, pela API compatível com S3 (veja docs/deploy.md):
#   - as chaves são uma "Customer Secret Key" (Perfil > Customer secret keys);
#   - a região é a da conta (ex.: sa-saopaulo-1);
#   - no endpoint, troque NAMESPACE pelo namespace do Object Storage da conta.
# Na AWS de verdade, deixe BACKUP_S3_ENDPOINT vazio.
BACKUP_S3_BUCKET=wishlisti-backups
BACKUP_S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
AWS_ACCESS_KEY_ID=TROCAR
AWS_SECRET_ACCESS_KEY=TROCAR
AWS_DEFAULT_REGION=sa-saopaulo-1
