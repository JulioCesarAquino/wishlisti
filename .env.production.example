# Modelo do .env de PRODUÇÃO. No servidor: cp .env.production.example .env
# e preencha tudo que está marcado com TROCAR. Nunca faça commit do .env real.
# Passo a passo completo: docs/deploy.md

APP_NAME=Wishlisti
APP_ENV=production
# Gere com: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Domínio do site, sem https:// (o Caddy emite o certificado para ele)
APP_DOMAIN=TROCAR.com.br
APP_URL=https://${APP_DOMAIN}

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr: os logs aparecem em "docker compose -f docker-compose.prod.yml logs"
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wishlisti
DB_USERNAME=wishlisti
# Senhas longas e diferentes entre si (ex.: openssl rand -base64 24)
DB_PASSWORD=TROCAR
DB_ROOT_PASSWORD=TROCAR

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail de verdade (convites, redefinição de senha). Exemplo com o SMTP do
# Amazon SES; os dados ficam no console do SES, em "SMTP settings".
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=TROCAR
MAIL_PASSWORD=TROCAR
MAIL_FROM_ADDRESS="nao-responda@${APP_DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"

# Conta Mercado Pago da plataforma (recebe o pagamento do plano premium).
# Use as credenciais de PRODUÇÃO, não as de teste.
MERCADOPAGO_ACCESS_TOKEN=TROCAR
MERCADOPAGO_PUBLIC_KEY=TROCAR
PREMIUM_PRICE=39.90
FREE_GIFT_LIMIT=15

# Backup diário (docker/backup.sh): bucket S3 que recebe as cópias.
# No EC2 com IAM Role, deixe as chaves vazias. No Lightsail, crie um usuário
# IAM só com permissão de escrita nesse bucket e preencha as chaves.
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
