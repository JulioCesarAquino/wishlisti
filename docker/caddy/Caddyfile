# Public entry point in production: gets and renews the HTTPS certificate
# (Let's Encrypt) for APP_DOMAIN on its own and forwards everything to nginx.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy nginx:80
}

# www is only a redirect to the main address (needs a DNS record for www too).
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
