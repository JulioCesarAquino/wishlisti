# Production image: code, PHP dependencies and the compiled frontend are baked
# in, so the server needs nothing but Docker. Built from the repository root by
# docker-compose.prod.yml (targets `app` and `nginx`).

# --- base: PHP and extensions (keep in sync with docker/php/Dockerfile) ------
FROM php:8.5-fpm-alpine AS base

RUN apk add --no-cache \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    libxml2-dev \
    oniguruma-dev \
    icu-dev \
    icu-data-full

RUN apk add --no-cache --virtual .build-deps autoconf g++ make \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php/php.prod.ini "$PHP_INI_DIR/conf.d/zz-wishlisti.ini"

WORKDIR /var/www/html

# --- build: installs dependencies and compiles the frontend ------------------
FROM base AS build

RUN apk add --no-cache git unzip nodejs npm
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Dependencies first, so they stay cached while only the code changes.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# .dockerignore leaves storage out; recreate the folders Laravel writes to.
RUN mkdir -p \
        storage/app/public \
        storage/app/private \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache

# Also runs post-autoload-dump (package:discover, filament:upgrade), which
# publishes the Filament assets into public/.
RUN composer dump-autoload --optimize --no-dev --no-interaction

# The .env is not in the image, so the app name the frontend shows comes from here.
ARG VITE_APP_NAME=Wishlisti
ENV VITE_APP_NAME=${VITE_APP_NAME}
RUN npm run build && rm -rf node_modules

# --- app: PHP-FPM (also used by the scheduler) -------------------------------
FROM base AS app

RUN addgroup -g 1000 www && adduser -u 1000 -G www -g www -s /bin/sh -D www

COPY --from=build --chown=www:www /var/www/html /var/www/html

COPY docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
RUN chmod 755 /usr/local/bin/entrypoint.prod.sh

USER www

ENTRYPOINT ["entrypoint.prod.sh"]
CMD ["php-fpm"]

# --- nginx: serves public/ and hands PHP requests to the app ----------------
FROM nginx:alpine AS nginx

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /var/www/html/public /var/www/html/public
